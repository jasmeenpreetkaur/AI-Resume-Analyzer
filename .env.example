# Optional Groq API key for LLM-generated explanations. Leave empty to use the deterministic fallback.
GROQ_API_KEY=

# Optional model override for scorer loading. Defaults to models/match_regressor.joblib.
MATCH_MODEL_PATH=models/match_regressor.joblib

# Optional validation report override. The default is reports/human_judgment_evaluation.json.
MATCH_VALIDATION_REPORT_PATH=reports/human_judgment_evaluation.json
